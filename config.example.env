# Copy to .env or export before running.
# 复制为 .env 或在启动前 export。

PROXY_HOST=0.0.0.0
PROXY_PORT=8722

# StepFun Plan upstream (OpenAI-compatible base, without trailing path quirks)
# Can also be changed later in the WebUI (persisted to data/settings.json)
STEP_UPSTREAM=https://api.stepfun.ai/step_plan/v1

# Claude Code / Anthropic SDK upstream base (StepFun's Anthropic-compatible
# Plan endpoint). Only the base — the proxy appends /v1/messages itself.
# ANTHROPIC_BASE_URL is accepted as an alias for this value.
ANTHROPIC_UPSTREAM=https://api.stepfun.ai/step_plan
# Fallback max_tokens for Anthropic requests (the upstream requires it).
# ANTHROPIC_MAX_TOKENS=8192

# Optional seed: used only on first start to create one upstream key.
# After that, add/revoke keys in the WebUI (data/upstreams.json).
# STEP_API_KEY=sk-your-stepfun-key

# Admin key for the WebUI and /api/* management routes.
# If unset on first start, auto-generated into data/master.token
# PROXY_MASTER_TOKEN=mtp_change_me

# When client asks stream+tools: force non-stream upstream, re-emit one complete SSE tool_call
# (applies to StepFun Plan nodes only; Anthropic nodes emit complete tool events natively)
FORCE_BUFFER=1

# Echo assistant reasoning_content back to the upstream on follow-up requests.
# Leave at 0 unless your client sends it back: StepFun rejects reasoning_content
# on assistant messages that also carry tool_calls.
# FORWARD_REASONING_HISTORY=0

# Data directory (tokens.json, master.token)
DATA_DIR=./data

# Optional: dump chat/completions request bodies with tools to data/
# DEBUG_DUMP=0
